#!/usr/bin/env bash
# Run the agent on a task as one engineer.
#
#   bin/run-as <who> <task.md> [--runtime pi|claude] [--strip-context]
#
# --strip-context removes AGENTS.md / CLAUDE.md files from the copy: the agent
# runs as if the team's context never reached it (a subagent, a compacted
# session, a misconfigured runtime). Hooks still load — they're runtime config.
#
# The engineer's personal layer (people/<who>.md) is appended to the system
# prompt — in real life it lives in ~/.claude or ~/.pi, outside the repo.
# The agent works in a throwaway copy of the repo, outside this directory
# (agents read context files from parent directories too), without people/.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
who="${1:?usage: bin/run-as <who> <task.md> [--runtime pi|claude]}"
task="${2:?usage: bin/run-as <who> <task.md> [--runtime pi|claude]}"
shift 2
runtime="${AGENT_RUNTIME:-}"
strip=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime) runtime="$2"; shift 2 ;;
    --strip-context) strip=1; shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done
if [[ -z "$runtime" ]]; then
  if command -v pi >/dev/null; then runtime=pi; else runtime=claude; fi
fi

persona_file="$root/people/$who.md"
[[ -f "$persona_file" ]] || { echo "no personal layer: $persona_file" >&2; exit 1; }
[[ -f "$root/$task" || -f "$task" ]] || { echo "no task file: $task" >&2; exit 1; }
task_text="$(cat "$root/$task" 2>/dev/null || cat "$task")"
# read everything from the repo up front: the working tree may change while the copy is prepared
persona="You are working with $who. These are $who's personal notes for their agent:

$(cat "$persona_file")"

runs="${HARNESS_RUNS:-$HOME/.cache/harness-first-demo/runs}"
dest="$runs/$who"
rm -rf "$dest"
mkdir -p "$dest"
# recordings/ and stage/ hold the presenter's answers (trap cases, recorded agent code):
# an attendee's agent must not see them.
rsync -a --exclude .git --exclude .venv --exclude people --exclude target \
  --exclude logs --exclude recordings --exclude stage \
  --exclude '*.duckdb' --exclude '*.duckdb.wal' "$root/" "$dest/"
ln -s "$root/.venv" "$dest/.venv"
if [[ $strip == 1 ]]; then
  find "$dest" \( -name AGENTS.md -o -name CLAUDE.md \) -not -path "*/.venv/*" -delete
fi
(
  cd "$dest"
  git init -q && git add -A && git -c user.name=demo -c user.email=demo@example.com commit -qm baseline
  DBT_PROFILES_DIR=. .venv/bin/dbt seed -q >/dev/null && DBT_PROFILES_DIR=. .venv/bin/dbt run -q -s staging >/dev/null
  if [[ "${SCENARIO_NO_WAREHOUSE:-0}" == 1 ]]; then   # act 4: the warehouse is unreachable
    rm -f demo.duckdb && mkdir demo.duckdb   # opening it fails: "Is a directory"
  fi
)

echo "▶ $who · $runtime · $dest"
cd "$dest"
export PATH="$dest/.venv/bin:$PATH" DBT_PROFILES_DIR=.
# act 3: the pi PII extension writes every outgoing provider request here
export PII_PAYLOAD_LOG="${PII_PAYLOAD_LOG:-$runs/$who.payload.jsonl}"
rm -f "$PII_PAYLOAD_LOG"
if [[ -n "${AGENT_FAKE:-}" ]]; then runtime=fake; fi   # act 4: a CLI that fails silently
case "$runtime" in
  fake)
    "$AGENT_FAKE" | tee "$runs/$who.log"
    ;;
  pi)
    # stdin closed: with an inherited, never-closing stdin pi -p waits forever
    pi -p --approve --no-session ${PI_ARGS:-} --append-system-prompt "$persona" "$task_text" \
      < /dev/null 2>&1 | tee "$runs/$who.log"
    ;;
  claude)
    claude -p "$task_text" --append-system-prompt "$persona" \
      --model "${CLAUDE_MODEL:-claude-sonnet-5-5}" \
      --setting-sources project,local \
      --allowedTools "Bash Read Edit Write Glob Grep" ${CLAUDE_ARGS:-} \
      < /dev/null 2>&1 | tee "$runs/$who.log"
    ;;
  *) echo "unknown runtime: $runtime" >&2; exit 2 ;;
esac
