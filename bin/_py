#!/usr/bin/env bash
# Runs bin/lib/<name>.py with the repo's virtualenv. Used by the bin/ wrappers.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"
py="$root/.venv/bin/python"
if [[ ! -x "$py" ]]; then
  echo "No virtualenv at $root/.venv — run: uv sync" >&2
  exit 1
fi
name="$1"; shift
exec "$py" "$here/lib/$name.py" "$@"
