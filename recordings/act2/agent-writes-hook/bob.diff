 /** Would this shell command run dbt against the prod target? */
 export function isProdRun(command) {
-  // TODO: act 2, exercise 2a
-  return false;
+  if (typeof command !== "string") return false;
+
+  // Only dbt invocations are in scope.
+  if (!/\bdbt\b/i.test(command)) return false;
+
+  // --target prod / --target=prod / -t prod (any whitespace or '=' separator).
+  const flagProd = /(?:--target|-t)[\s=]+prod\b/i.test(command);
+
+  // DBT_TARGET=prod set as an env var anywhere in the command line.
+  const envProd = /\bDBT_TARGET=prod\b/i.test(command);
+
+  return flagProd || envProd;
 }
 
